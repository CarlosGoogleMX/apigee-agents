# ==============================================================================
# APIGEE ERROR DIAGNOSTIC AGENT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- REQUIRED VARIABLES ---
# Target Google Cloud Project ID hosting Apigee error logs and API Hub
GCP_PROJECT=your-gcp-project-id

# Default recipient email for alerts when an API proxy owner is not registered in API Hub
DEFAULT_OWNER_EMAIL=api-ops@example.com

# --- OPTIONAL: GOOGLE CLOUD VERTEX AI & GEMINI CONFIGURATION ---
# The agent connects to Google Cloud Vertex AI using Application Default Credentials (ADC) or Service Account.
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_GENAI_USE_VERTEXAI=true
# MODEL_NAME=gemini-2.5-flash
# APIHUB_LOCATION=global

# --- OPTIONAL: ORGANIZATION ALIAS MAPPINGS ---
# JSON map of human-readable organization/project aliases to canonical GCP Project IDs
# ORG_MAPPINGS_JSON={"my-prod-project": ["prod", "production"]}

# --- OPTIONAL: BRANDING & WEB REPORT SERVING ---
# COMPANY_NAME=API Operations Team
# LOGO_URL=https://cloud.google.com/_static/cloud/images/social-icon-google-cloud-1200-630.png
# Public base URL for serving HTML diagnostic reports over HTTP (set to your Cloud Run service URL in production)
# APP_BASE_URL=https://your-cloud-run-service.a.run.app

# --- OPTIONAL: SMTP EMAIL DISPATCH ---
# In Cloud Run / Kubernetes, store SMTP_PASSWORD (and SMTP config) in Google Cloud Secret Manager
# and bind them as environment variables.
# For local testing only, you can provide test SMTP credentials below:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=apigee-alerts@example.com
